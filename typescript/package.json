{
  "name": "modal-template",
  "version": "0.1.0",
  "private": true,
  "description": "A Restate application on Modal, connected to Restate Cloud: the sessions tutorial, a wallet per user, from a SQL database per key to agents",
  "license": "MIT",
  "type": "module",
  "scripts": {
    "typecheck": "tsc -p .",
    "lint": "pnpm typecheck && OXLINT_TSGOLINT_PATH=node_modules/.bin/tsgolint oxlint --type-aware src && oxfmt --check",
    "format": "oxfmt"
  },
  "dependencies": {
    "@earendil-works/chord": "1.4.0",
    "@earendil-works/pi-ai": "1.4.0",
    "@earendil-works/pi-durable": "1.4.0",
    "@restatedev/agents": "0.4.0",
    "@restatedev/sessions": "0.4.0",
    "zod": "4.6.5"
  },
  "devDependencies": {
    "@restatedev/restate-sdk-clients": "1.18.2",
    "@types/node": "24.19.2",
    "oxfmt": "0.72.0",
    "oxlint": "1.87.0",
    "oxlint-tsgolint": "7.0.2004",
    "typescript": "7.0.2"
  },
  "engines": {
    "node": ">=24"
  },
  "packageManager": "pnpm@11.27.0"
}
